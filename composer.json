{
    "name": "tonka/astro",
    "type": "project",
    "version": "1.11.0",
    "description": "Tonka Framework InertiaJs ReactJs Starter Kit",
    "keywords": ["framework", "tonka", "InertiaJs", "ReactJs"],
    "license": "MIT",
    "require": {
        "clicalmani/broadcaster": "^1.1.0",
        "clicalmani/console": "^2.7.0",
        "clicalmani/database": "^3.3.8",
        "clicalmani/foundation": "^3.4.0",
        "clicalmani/psr": "^1.1.0",
        "clicalmani/routing": "^2.5.0",
        "clicalmani/validation": "^3.2.0",
        "clicalmani/xpower": "^1.2.0",
        "inertia/tonka-adapter": "^1.2.0",
        "symfony/event-dispatcher": "^7.4",
        "symfony/mailer": "^7.4",
        "tonka/driftql": "^1.6.0",
        "tonka/spark": "^1.3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "database",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Database\\Entities\\": "database/entities/",
            "Test\\": "test/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/docs",
            "/test"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^13"
    }
}
